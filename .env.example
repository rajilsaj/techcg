# Database connection (Supabase PostgreSQL with connection pooler)
# From Vercel Supabase integration - pooled connection for queries
POSTGRES_PRISMA_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Non-pooling connection for migrations
POSTGRES_URL_NON_POOLING="postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Cron job secret (change in production)
CRON_SECRET="dev-secret-change-in-prod"

# Supabase authentication
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR-KEY]"
SUPABASE_SECRET_KEY="sb_secret_[YOUR-KEY]"
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"
