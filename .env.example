# Database connection (Supabase PostgreSQL with connection pooler)
# Pooled connection (port 6543, pgbouncer=true) - used for regular queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used only for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Cron job secret (change in production)
CRON_SECRET="dev-secret-change-in-prod"

# Supabase authentication
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR-KEY]"
SUPABASE_SECRET_KEY="sb_secret_[YOUR-KEY]"
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"
