generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String?
  firebaseUid  String?  @unique
  email        String?
  phone        String?
  about        String?
  karma        Int      @default(0)
  shadowBanned Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  banned       Boolean  @default(false) // can't sign in or post
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items    Item[]
  votes    Vote[]
  hidden   HiddenItem[]
  media    Media[]
  activity ActivityLog[]
  apiKeys  ApiKey[]

  @@index([karma])
  @@index([createdAt])
}

model Item {
  id    Int     @id @default(autoincrement())
  type  String // 'story' | 'comment' | 'ask' | 'show' | 'job'
  title String?
  url   String?
  text  String?

  // Link preview, filled in after submission (see src/lib/enrich-story.ts)
  titleLang     String? // language `title` is in; "fr" once translated (see src/lib/enrich-story.ts)
  originalTitle String? // the title before translation, kept for search
  keywords      String[]  @default([]) // tags/keywords the article declares (feed categories, meta tags)
  excerpt       String? // in French when translation succeeded
  excerptLang   String? // language of `excerpt`, e.g. "fr", "en"
  imageUrl      String?
  previewAt     DateTime? // last preview attempt; null = never tried
  /// Estimated reading time of the linked article (advanced scraper), in minutes.
  readingMinutes Int?
  /// When the scraper last analysed the article page (text, cover size).
  analyzedAt     DateTime?
  metaManual    Boolean   @default(false) // meta tags/region picked by an admin: not recomputed
  authorId      Int
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   Item?  @relation("Comments", fields: [parentId], references: [id], onDelete: Cascade)
  children Item[] @relation("Comments")
  path     String @default("")
  depth    Int    @default(0)

  points    Int          @default(1)
  rankScore Float        @default(0)
  rankedAt  DateTime     @default(now())
  votes     Vote[]
  hiddenBy  HiddenItem[]

  flagCount Int     @default(0)
  deleted   Boolean @default(false) // deprecated: replaced by status "trash"

  // Publication workflow (see src/lib/content-status.ts)
  status    String    @default("published") // published | draft | pending | scheduled | spam | trash
  publishAt DateTime? // for status "scheduled"

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       ItemTag[]

  importSourceId Int?
  importSource   ImportSource? @relation(fields: [importSourceId], references: [id], onDelete: SetNull)

  commentCount Int      @default(0)
  /// How many visitors consulted it: opened the article from a list or viewed its page (once per visitor per day).
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, createdAt])
  @@index([parentId])
  @@index([rankScore])
  @@index([viewCount])
  @@index([commentCount])
  @@index([authorId])
  @@index([deleted])
  @@index([status])
  @@index([categoryId])
  @@index([importSourceId])
}

model Vote {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId Int
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// +1 = upvote, -1 = downvote.
  value  Int  @default(1)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

/// Stories a user chose to hide from their lists.
model HiddenItem {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, itemId])
  @@index([itemId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  items       Item[]
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  items     ItemTag[]
}

model ItemTag {
  itemId Int
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tagId  Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

/// Site-wide settings edited in the admin, stored as key/value (see src/lib/settings.ts).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Admin actions, shown in the admin's activity log.
model ActivityLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  summary    String
  targetType String?
  targetId   Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Files uploaded to Vercel Blob from the admin's media library.
model Media {
  id           Int      @id @default(autoincrement())
  url          String
  pathname     String   @unique
  contentType  String
  size         Int
  alt          String   @default("")
  uploadedById Int?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Websites the admin imports articles from (see src/lib/importer).
model ImportSource {
  id         Int       @id @default(autoincrement())
  name       String
  url        String // homepage or RSS/Atom feed
  enabled    Boolean   @default(true)
  maxItems   Int       @default(20)
  categoryId Int?
  /// Meta topic (startups, entrepreneurs, tech, evenements) given to its articles when none is detected.
  topic      String?
  /// « Filtrer »: keep only articles clearly about startups, entrepreneurs or tech (general-news sites).
  strict     Boolean   @default(true)
  /// Public card on /sources (read from the site's homepage, editable in the admin).
  siteName    String?
  description String?
  logoUrl     String?
  country     String?
  profiledAt  DateTime?
  lastRunAt  DateTime?
  lastResult String? // human-readable summary of the last run
  createdAt  DateTime  @default(now())
  items      Item[]
}

/// One page view, recorded by the tracker in the root layout (see src/lib/analytics).
/// Deleted after the retention period set in the admin.
model PageView {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  path       String
  referrer   String? // external referring site only
  // Network & location (Vercel geolocation headers)
  ip         String
  country    String? // ISO 3166-1 alpha-2
  region     String?
  city       String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  timezone   String?
  // Device (parsed from the user agent, plus what the browser reports)
  userAgent  String
  browser    String?
  browserVer String?
  os         String?
  osVer      String?
  device     String // desktop | mobile | tablet | bot
  isBot      Boolean  @default(false)
  screen     String? // e.g. "1920x1080"
  language   String?
  clientTz   String?
  // Who
  visitorId  String // first-party cookie, ~1 year
  sessionId  String // per browser tab session
  userId     Int?
  durationMs Int? // time on page, reported when the visitor leaves

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([visitorId])
  @@index([sessionId])
}

/// Profiles.CG: Congolese people in tech, curated by admins (not member accounts).
model Profile {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  role         String   @default("") // e.g. "Fondatrice"
  organization String?
  city         String?
  country      String   @default("CG") // CG = Congo-Brazzaville, CD = RD Congo
  photoUrl     String?
  bio          String?
  website      String?
  linkedin     String?
  twitter      String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, name])
}

/// A member's personal key for the public API (Authorization: Bearer tcg_…). Only its SHA-256 is stored.
model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First characters of the key, shown so the member can tell keys apart.
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
